VOYAGE_API_KEY=
# Optional: tracing
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=redblue
# Optional: OpenRouter model slugs (defaults in backend/llm.py)
MOVE_MODEL=
EVOLVE_MODEL=
